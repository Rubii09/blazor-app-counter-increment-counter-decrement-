@page "/counter"
@rendermode InteractiveServer

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p role="status">Current count: @count</p>
<button class="btn btn-primary" @onclick="increment">Click me</button>
<button class="btn btn-secondary" @onclick="decrement">Click me</button>

@code {
    CounterManager cm = new CounterManager();

    public int count = 0;
    void increment()
    {
        cm.Increment();
        count = cm.getCount();

    }
    void decrement()
    {
        cm.Decrement();
        count = cm.getCount();
    }   
}


    

